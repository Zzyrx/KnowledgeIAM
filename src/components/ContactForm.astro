<p class="text-sm text-iam-muted mb-4"><span aria-hidden="true">*</span> <span class="sr-only">L'astérisque</span> indique un champ obligatoire</p>

<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-6"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Ne pas remplir : <input name="bot-field" /></label>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-medium text-iam-muted mb-2">Nom *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        aria-required="true"
        autocomplete="name"
        class="w-full px-4 py-3 rounded-lg bg-iam-medium border border-white/10 text-white placeholder-iam-muted/50 focus:border-iam-cyan focus:ring-2 focus:ring-iam-cyan outline-none transition-colors"
        placeholder="Votre nom"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-iam-muted mb-2">Email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        aria-required="true"
        autocomplete="email"
        class="w-full px-4 py-3 rounded-lg bg-iam-medium border border-white/10 text-white placeholder-iam-muted/50 focus:border-iam-cyan focus:ring-2 focus:ring-iam-cyan outline-none transition-colors"
        placeholder="votre@email.com"
      />
    </div>
  </div>

  <div>
    <label for="company" class="block text-sm font-medium text-iam-muted mb-2">Entreprise</label>
    <input
      type="text"
      id="company"
      name="company"
      autocomplete="organization"
      class="w-full px-4 py-3 rounded-lg bg-iam-medium border border-white/10 text-white placeholder-iam-muted/50 focus:border-iam-cyan focus:ring-2 focus:ring-iam-cyan outline-none transition-colors"
      placeholder="Votre entreprise"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-iam-muted mb-2">Message *</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      aria-required="true"
      maxlength="5000"
      class="w-full px-4 py-3 rounded-lg bg-iam-medium border border-white/10 text-white placeholder-iam-muted/50 focus:border-iam-cyan focus:ring-2 focus:ring-iam-cyan outline-none transition-colors resize-y"
      placeholder="Décrivez votre projet ou votre besoin..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full sm:w-auto px-8 py-3 bg-iam-cyan text-iam-dark font-semibold rounded-lg hover:bg-iam-cyan/90 transition-colors"
  >
    Envoyer le message
  </button>
</form>
