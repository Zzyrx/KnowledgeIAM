---
interface Props {
  name: string;
  code: string;
  status: 'preparation' | 'obtained';
  description: string;
  skills: string[];
}

const { name, code, status, description, skills } = Astro.props;

const statusConfig = {
  preparation: { label: 'En préparation', color: 'bg-amber-500/10 text-amber-400 border-amber-500/20' },
  obtained: { label: 'Obtenue', color: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
};

const { label, color } = statusConfig[status];
---

<div class="p-6 rounded-xl border border-white/10 bg-iam-medium/50">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
    <div>
      <h3 class="text-lg font-semibold text-white">{code}</h3>
      <p class="text-iam-cyan text-sm font-medium">{name}</p>
    </div>
    <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full border ${color}`}>
      {status === 'preparation' && (
        <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
      {status === 'obtained' && (
        <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      )}
      {label}
    </span>
  </div>

  <p class="text-sm text-iam-muted leading-relaxed mb-4">{description}</p>

  <div>
    <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-2">Compétences couvertes</h4>
    <ul class="space-y-1.5">
      {skills.map((skill) => (
        <li class="flex items-start gap-2 text-sm text-iam-muted">
          <svg aria-hidden="true" class="w-4 h-4 text-iam-cyan mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{skill}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
