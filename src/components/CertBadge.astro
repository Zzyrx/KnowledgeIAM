---
interface Props {
  name: string;
  code: string;
  status: 'preparation' | 'obtained';
  description: string;
  skills: string[];
}

const { name, code, status, description, skills } = Astro.props;

const statusConfig = {
  preparation: { label: 'En preparation', bg: 'bg-amber-500/10', text: 'text-amber-400', border: 'border-amber-500/20', dot: 'bg-amber-400' },
  obtained: { label: 'Obtenue', bg: 'bg-emerald-500/10', text: 'text-emerald-400', border: 'border-emerald-500/20', dot: 'bg-emerald-400' },
};

const st = statusConfig[status];
---

<div class="glass-card p-6">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
    <div>
      <h3 class="text-lg font-semibold text-white">{code}</h3>
      <p class="text-iam-cyan text-sm font-medium">{name}</p>
    </div>
    <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-lg border ${st.bg} ${st.text} ${st.border}`}>
      <span class={`w-1.5 h-1.5 rounded-full ${st.dot}`}></span>
      {st.label}
    </span>
  </div>

  <p class="text-sm text-iam-muted leading-relaxed mb-5">{description}</p>

  <div>
    <h4 class="text-xs font-semibold text-white/70 uppercase tracking-wider mb-3">Competences couvertes</h4>
    <ul class="space-y-2">
      {skills.map((skill) => (
        <li class="flex items-start gap-2.5 text-sm text-iam-muted">
          <svg aria-hidden="true" class="w-4 h-4 text-iam-cyan mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{skill}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
