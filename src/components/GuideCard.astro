---
interface Props {
  title: string;
  description: string;
  slug: string;
  chapters: number;
  readingTime?: string;
  tags: string[];
}

const { title, description, slug, chapters, readingTime, tags } = Astro.props;
---

<a href={`/guides/${slug}/`} class="group block glass-card-hover p-6 cursor-pointer">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="text-lg font-semibold text-white group-hover:text-iam-cyan transition-colors duration-300">{title}</h3>
    <svg aria-hidden="true" class="w-5 h-5 text-iam-muted group-hover:text-iam-cyan transition-colors duration-300 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
  <p class="text-sm text-iam-muted leading-relaxed mb-4">{description}</p>
  <div class="flex items-center gap-3 text-xs text-iam-muted/70 mb-3">
    <span class="flex items-center gap-1">
      <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      {chapters} chapitres
    </span>
    {readingTime && <span>{readingTime}</span>}
  </div>
  <div class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="tag-badge">{tag}</span>
    ))}
  </div>
</a>
