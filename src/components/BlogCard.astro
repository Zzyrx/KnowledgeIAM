---
interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  tags: string[];
}

const { title, description, slug, date, tags } = Astro.props;

const formatted = date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}/`} class="group block glass-card-hover p-6 cursor-pointer">
  <div class="flex flex-wrap gap-1.5 mb-3">
    {tags.map((tag) => (
      <span class="tag-badge">{tag}</span>
    ))}
  </div>
  <h3 class="text-lg font-semibold text-white group-hover:text-iam-cyan transition-colors duration-300 mb-2">{title}</h3>
  <p class="text-sm text-iam-muted leading-relaxed mb-3">{description}</p>
  <time datetime={date.toISOString()} class="text-xs text-iam-muted/70">{formatted}</time>
</a>
