---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocItem[];
}

const { headings } = Astro.props;

// Only keep h2 and h3
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<nav class="toc" aria-label="Table des matières">
  <h2 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Sommaire</h2>
  <ul class="space-y-1 text-sm">
    {filtered.map((h) => (
      <li class={h.depth === 3 ? 'pl-4' : ''}>
        <a
          href={`#${h.slug}`}
          class:list={[
            'block py-1 transition-colors hover:text-iam-cyan',
            h.depth === 2 ? 'text-iam-muted font-medium' : 'text-iam-muted/70',
          ]}
        >
          {h.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Highlight active TOC item on scroll
  const links = document.querySelectorAll('.toc a');
  const headings = Array.from(links).map((link) => {
    const id = link.getAttribute('href')?.slice(1);
    return id ? document.getElementById(id) : null;
  }).filter(Boolean) as HTMLElement[];

  function updateActive() {
    const scrollY = window.scrollY + 100;
    let current = 0;
    for (let i = 0; i < headings.length; i++) {
      if (headings[i].offsetTop <= scrollY) current = i;
    }
    links.forEach((link, i) => {
      link.classList.toggle('text-iam-cyan', i === current);
      link.classList.toggle('text-iam-muted', i !== current && link.closest('li')?.classList.contains('pl-4') === false);
      link.classList.toggle('text-iam-muted/70', i !== current && link.closest('li')?.classList.contains('pl-4') === true);
    });
  }

  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
</script>
