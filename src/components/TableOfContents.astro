---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocItem[];
}

const { headings } = Astro.props;

// Only keep h2 and h3
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<nav class="toc" aria-label="Table des matieres">
  <h2 class="text-xs font-semibold text-white/70 uppercase tracking-wider mb-4">Sommaire</h2>
  <ul class="space-y-0.5 text-sm">
    {filtered.map((h) => (
      <li class={h.depth === 3 ? 'pl-4' : ''}>
        <a
          href={`#${h.slug}`}
          class:list={[
            'block py-1.5 transition-colors duration-200 hover:text-iam-cyan cursor-pointer',
            h.depth === 2 ? 'text-iam-muted font-medium' : 'text-iam-muted/60',
          ]}
        >
          {h.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  // Guard contre la double execution (le composant est instancie 2 fois)
  if (!window.__tocInitialized) {
    window.__tocInitialized = true;

    const links = document.querySelectorAll('.toc a');
    const headings = Array.from(links).map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    }).filter(Boolean);

    function updateActive() {
      const scrollY = window.scrollY + 100;
      let current = 0;
      for (let i = 0; i < headings.length; i++) {
        if (headings[i].offsetTop <= scrollY) current = i;
      }
      links.forEach((link, i) => {
        link.classList.toggle('text-iam-cyan', i === current);
        link.classList.toggle('text-iam-muted', i !== current && link.closest('li')?.classList.contains('pl-4') === false);
        link.classList.toggle('text-iam-muted/60', i !== current && link.closest('li')?.classList.contains('pl-4') === true);
      });
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateActive(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    updateActive();
  }
</script>
