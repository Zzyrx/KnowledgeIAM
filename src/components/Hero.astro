---
interface Props {
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
}

const { title, subtitle, cta } = Astro.props;
---

<section class="relative overflow-hidden py-24 sm:py-32">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-iam-dark via-iam-medium to-iam-dark"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-iam-cyan/10 via-transparent to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
      <slot name="title">
        <Fragment set:html={title} />
      </slot>
    </h1>
    {subtitle && (
      <p class="mt-6 text-lg sm:text-xl text-iam-muted max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )}
    {cta && (
      <div class="mt-10">
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 px-8 py-3 bg-iam-cyan text-iam-dark font-semibold rounded-lg hover:bg-iam-cyan/90 transition-colors"
        >
          {cta.label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
