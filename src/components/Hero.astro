---
interface Props {
  title: string;
  subtitle?: string;
  cta?: { label: string; href: string };
  badge?: string;
}

const { title, subtitle, cta, badge } = Astro.props;
---

<section class="relative overflow-hidden py-28 sm:py-36">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-iam-dark"></div>
  <div class="absolute inset-0 grid-pattern opacity-60"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-iam-cyan/[0.07] via-transparent to-transparent"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-radial from-iam-cyan/[0.08] via-iam-violet/[0.03] to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {badge && (
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full border border-white/[0.08] bg-white/[0.03] text-sm text-iam-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        {badge}
      </div>
    )}

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]">
      <slot name="title">
        <Fragment set:html={title} />
      </slot>
    </h1>

    {subtitle && (
      <p class="mt-6 text-lg sm:text-xl text-iam-muted max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )}

    {cta && (
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={cta.href} class="btn-primary">
          {cta.label}
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
