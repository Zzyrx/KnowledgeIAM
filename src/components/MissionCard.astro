---
interface Props {
  company: string;
  role: string;
  period: string;
  highlights: string[];
}

const { company, role, period, highlights } = Astro.props;
---

<div class="p-6 rounded-xl border border-white/10 bg-iam-medium/50">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
    <div>
      <h3 class="text-lg font-semibold text-white">{company}</h3>
      <p class="text-sm text-iam-cyan">{role}</p>
    </div>
    <span class="text-sm text-iam-muted">{period}</span>
  </div>
  <ul class="space-y-2">
    {highlights.map((item) => (
      <li class="flex items-start gap-2 text-sm text-iam-muted">
        <svg class="w-4 h-4 text-iam-cyan mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
