---
interface Props {
  company: string;
  role: string;
  period: string;
  highlights: string[];
}

const { company, role, period, highlights } = Astro.props;
---

<div class="glass-card p-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-5">
    <div>
      <h3 class="text-lg font-semibold text-white">{company}</h3>
      <p class="text-sm text-iam-cyan font-medium">{role}</p>
    </div>
    <span class="text-xs text-iam-muted bg-white/[0.04] px-3 py-1 rounded-lg">{period}</span>
  </div>
  <ul class="space-y-2.5">
    {highlights.map((item) => (
      <li class="flex items-start gap-2.5 text-sm text-iam-muted">
        <svg aria-hidden="true" class="w-4 h-4 text-iam-cyan mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
