---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  author: string;
}

const { title, description, date, tags, author } = Astro.props;

const formatted = date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Jean-Baptiste Janssen`} description={description}>
  <article class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-12">
        <a href="/blog/" class="inline-flex items-center gap-1 text-sm text-iam-muted hover:text-iam-cyan transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Retour au blog
        </a>
        <h1 class="text-3xl sm:text-4xl font-bold">{title}</h1>
        <p class="mt-4 text-lg text-iam-muted leading-relaxed">{description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
          <span class="text-iam-muted">{author}</span>
          <span class="text-white/20">&middot;</span>
          <time datetime={date.toISOString()} class="text-iam-muted">{formatted}</time>
        </div>
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-iam-cyan/10 text-iam-cyan border border-iam-cyan/20">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-invert prose-cyan max-w-none
        prose-headings:scroll-mt-24
        prose-h2:text-xl prose-h2:font-bold prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-lg prose-h3:font-semibold prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-iam-muted prose-p:leading-relaxed
        prose-li:text-iam-muted
        prose-a:text-iam-cyan prose-a:no-underline hover:prose-a:underline
        prose-strong:text-white
        prose-code:text-iam-cyan prose-code:bg-iam-medium prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-iam-medium prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl
        prose-blockquote:border-iam-cyan prose-blockquote:text-iam-muted">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
