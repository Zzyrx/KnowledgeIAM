---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout
  title="Décodeur JWT — Outil interactif"
  description="Décodez un JSON Web Token (JWT) : header, claims, expiration. Détection des pièges de sécurité (alg: none, token expiré). Traitement 100 % local, aucun token envoyé."
>
  <section class="py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Retour -->
      <a href="/outils/" class="inline-flex items-center gap-1 text-sm text-iam-muted hover:text-iam-cyan transition-colors duration-200 mb-6 cursor-pointer">
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Retour aux outils
      </a>

      <header class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold">Décodeur JWT</h1>
        <p class="mt-4 text-lg text-iam-muted max-w-2xl leading-relaxed">
          Collez un JSON Web Token pour inspecter son contenu. Le décodage détaille le header,
          les claims (avec dates lisibles) et signale les pièges de sécurité courants.
        </p>
      </header>

      <!-- Bandeau confidentialité -->
      <div class="mb-8 flex items-start gap-3 p-4 rounded-xl border border-emerald-400/20 bg-emerald-400/[0.06]">
        <svg aria-hidden="true" class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <p class="text-sm text-iam-muted leading-relaxed">
          <strong class="text-white">Traitement 100 % local.</strong> Le décodage s'exécute dans votre navigateur.
          Aucun token n'est envoyé ni stocké. Un JWT n'est <em>pas chiffré</em> : ne le partagez jamais publiquement.
        </p>
      </div>

      <!-- Zone de saisie -->
      <div class="glass-card p-5 mb-6">
        <label for="jwt-input" class="block text-sm font-semibold text-white mb-2">Votre JWT</label>
        <textarea
          id="jwt-input"
          rows="5"
          spellcheck="false"
          autocomplete="off"
          class="w-full font-mono text-sm bg-iam-dark border border-white/10 rounded-xl p-4 text-iam-text placeholder:text-iam-muted/50 focus:outline-none focus:border-iam-cyan/50 resize-y break-all"
          placeholder="eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0..."
          aria-describedby="jwt-error"
        ></textarea>
        <div class="flex flex-wrap gap-3 mt-3">
          <button id="jwt-example" type="button" class="btn-secondary text-sm py-2 px-4">Charger un exemple</button>
          <button id="jwt-clear" type="button" class="btn-secondary text-sm py-2 px-4">Effacer</button>
        </div>
      </div>

      <!-- Erreur -->
      <div id="jwt-error" role="alert" aria-live="polite" class="hidden mb-6 p-4 rounded-xl border border-red-400/30 bg-red-400/[0.08] text-sm text-red-300"></div>

      <!-- Résultats -->
      <div id="jwt-results" class="hidden space-y-6" aria-live="polite">
        <!-- Structure -->
        <div>
          <h2 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Structure</h2>
          <div id="jwt-structure" class="font-mono text-sm break-all glass-card p-4 leading-relaxed"></div>
        </div>

        <!-- Alertes sécurité -->
        <div id="jwt-alerts" class="space-y-2"></div>

        <!-- Header + Payload -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div>
            <h2 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Header</h2>
            <pre class="glass-card p-4 overflow-x-auto text-sm"><code id="jwt-header" class="text-iam-text font-mono"></code></pre>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Payload</h2>
            <pre class="glass-card p-4 overflow-x-auto text-sm"><code id="jwt-payload" class="text-iam-text font-mono"></code></pre>
          </div>
        </div>

        <!-- Claims détaillés -->
        <div>
          <h2 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Claims interprétés</h2>
          <div class="glass-card overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="py-3 px-4 text-iam-muted font-medium">Claim</th>
                  <th class="py-3 px-4 text-iam-muted font-medium">Valeur</th>
                  <th class="py-3 px-4 text-iam-muted font-medium">Signification</th>
                </tr>
              </thead>
              <tbody id="jwt-claims"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Contenu pédagogique -->
      <div class="mt-16 prose-iam max-w-3xl">
        <h2 class="text-xl font-bold text-white">Comprendre les JWT</h2>
        <p>
          Un <strong>JWT</strong> (JSON Web Token, RFC 7519) est un jeton compact composé de trois parties
          séparées par des points : <code>header.payload.signature</code>. Chaque partie est encodée en
          <strong>Base64URL</strong> — c'est un encodage, <em>pas</em> un chiffrement : n'importe qui peut lire le contenu.
          La signature garantit seulement l'<strong>intégrité</strong> et l'<strong>authenticité</strong> du token, pas sa confidentialité.
        </p>
        <p>
          Cet outil <strong>ne vérifie pas la signature</strong> : cela nécessiterait la clé publique (RS256/ES256)
          ou le secret partagé (HS256) de l'émetteur. Il décode le contenu et met en évidence les problèmes de structure et d'expiration.
        </p>
        <p>
          Les JWT sont au cœur d'<a href="/expertise/protocoles/">OIDC et OAuth 2.0</a> : les <em>ID Tokens</em> et
          <em>Access Tokens</em> sont généralement des JWT. Pour approfondir, consultez le
          <a href="/guides/oidc/">guide OpenID Connect</a>.
        </p>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<script>
  // ---- Références DOM ----
  const input = document.getElementById('jwt-input') as HTMLTextAreaElement | null;
  const errorBox = document.getElementById('jwt-error');
  const results = document.getElementById('jwt-results');
  const structureEl = document.getElementById('jwt-structure');
  const alertsEl = document.getElementById('jwt-alerts');
  const headerEl = document.getElementById('jwt-header');
  const payloadEl = document.getElementById('jwt-payload');
  const claimsEl = document.getElementById('jwt-claims');
  const exampleBtn = document.getElementById('jwt-example');
  const clearBtn = document.getElementById('jwt-clear');

  // Garde : si un élément manque, on n'initialise rien.
  if (input && errorBox && results && structureEl && alertsEl && headerEl && payloadEl && claimsEl && exampleBtn && clearBtn) {
    // ---- Dictionnaire des claims standards (RFC 7519 + OIDC) ----
    const CLAIM_DESCRIPTIONS: Record<string, string> = {
      iss: 'Émetteur du token (issuer)',
      sub: "Sujet : identifiant de l'utilisateur ou de l'entité",
      aud: 'Audience : destinataire(s) prévu(s) du token',
      exp: "Date d'expiration (au-delà, le token est invalide)",
      nbf: 'Valide à partir de (not before)',
      iat: 'Date d’émission (issued at)',
      jti: 'Identifiant unique du token (anti-rejeu)',
      azp: 'Partie autorisée (authorized party)',
      nonce: 'Valeur anti-rejeu liant le token à la requête (OIDC)',
      acr: 'Niveau de garantie d’authentification (authentication context)',
      amr: 'Méthodes d’authentification utilisées (mfa, pwd, otp…)',
      auth_time: "Date de l'authentification effective",
      scope: 'Portées OAuth 2.0 accordées',
      scp: 'Portées OAuth 2.0 accordées',
      client_id: 'Identifiant du client OAuth',
      appid: 'Identifiant de l’application (Entra ID)',
      name: 'Nom affiché',
      given_name: 'Prénom',
      family_name: 'Nom de famille',
      preferred_username: 'Nom d’utilisateur préféré',
      email: 'Adresse email',
      email_verified: 'Email vérifié',
      roles: 'Rôles attribués',
      groups: 'Groupes d’appartenance',
      tid: 'Identifiant du tenant (Entra ID)',
      typ: 'Type de token',
    };

    const TIME_CLAIMS = new Set(['exp', 'iat', 'nbf', 'auth_time']);

    // ---- Décodage Base64URL robuste (gère l'UTF-8) ----
    function base64UrlDecode(segment: string): string {
      let b64 = segment.replace(/-/g, '+').replace(/_/g, '/');
      const pad = b64.length % 4;
      if (pad === 2) b64 += '==';
      else if (pad === 3) b64 += '=';
      else if (pad === 1) throw new Error('Segment Base64URL invalide.');
      const binary = atob(b64);
      const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
      return new TextDecoder('utf-8').decode(bytes);
    }

    // ---- Helpers de rendu (toujours via textContent : jamais d'injection HTML) ----
    function el(tag: string, className?: string, text?: string): HTMLElement {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function formatDate(epoch: number): string {
      const d = new Date(epoch * 1000);
      if (Number.isNaN(d.getTime())) return String(epoch);
      const abs = d.toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'medium' });
      const diffSec = epoch - Math.floor(Date.now() / 1000);
      return `${abs} (${relative(diffSec)})`;
    }

    function relative(diffSec: number): string {
      const past = diffSec < 0;
      let s = Math.abs(diffSec);
      const units: [number, string][] = [
        [86400, 'j'],
        [3600, 'h'],
        [60, 'min'],
        [1, 's'],
      ];
      let out = '';
      for (const [size, label] of units) {
        if (s >= size) {
          out = `${Math.floor(s / size)} ${label}`;
          break;
        }
      }
      if (!out) out = "à l'instant";
      return past ? `il y a ${out}` : `dans ${out}`;
    }

    function stringify(value: unknown): string {
      if (typeof value === 'object' && value !== null) return JSON.stringify(value);
      return String(value);
    }

    function addAlert(level: 'critical' | 'warning' | 'info', message: string): void {
      const styles: Record<string, string> = {
        critical: 'border-red-400/30 bg-red-400/[0.08] text-red-300',
        warning: 'border-amber-400/30 bg-amber-400/[0.08] text-amber-300',
        info: 'border-iam-cyan/25 bg-iam-cyan/[0.06] text-iam-cyan',
      };
      const box = el('div', `flex items-start gap-2.5 p-3 rounded-lg border text-sm ${styles[level]}`);
      const icon = level === 'critical' ? '✖' : level === 'warning' ? '⚠' : 'ℹ';
      box.appendChild(el('span', 'font-bold flex-shrink-0', icon));
      box.appendChild(el('span', '', message));
      alertsEl!.appendChild(box);
    }

    // ---- Rendu de la structure colorée (header.payload.signature) ----
    function renderStructure(parts: string[]): void {
      structureEl!.textContent = '';
      const colors = ['text-iam-cyan', 'text-iam-violet', 'text-emerald-400', 'text-amber-400', 'text-red-400'];
      parts.forEach((part, i) => {
        if (i > 0) structureEl!.appendChild(el('span', 'text-iam-muted', '.'));
        structureEl!.appendChild(el('span', colors[i] || 'text-iam-muted', part));
      });
    }

    // ---- Rendu principal ----
    function decode(): void {
      const raw = input!.value.trim();
      errorBox!.classList.add('hidden');
      errorBox!.textContent = '';
      alertsEl!.textContent = '';
      claimsEl!.textContent = '';

      if (!raw) {
        results!.classList.add('hidden');
        return;
      }

      const parts = raw.split('.');

      // JWE (5 parties) : le payload est chiffré, on ne peut décoder que le header.
      if (parts.length === 5) {
        try {
          const header = JSON.parse(base64UrlDecode(parts[0]));
          renderStructure(parts);
          headerEl!.textContent = JSON.stringify(header, null, 2);
          payloadEl!.textContent = '// Payload chiffré (JWE) — impossible à décoder sans la clé.';
          results!.classList.remove('hidden');
          addAlert('info', 'Ce token est un JWE (chiffré) : seul le header est lisible. Le contenu nécessite la clé de déchiffrement.');
        } catch {
          showError('Token à 5 segments (JWE présumé) mais le header est illisible.');
        }
        return;
      }

      if (parts.length !== 3) {
        showError(`Un JWT valide comporte 3 segments séparés par des points (trouvé : ${parts.length}).`);
        return;
      }

      let header: Record<string, unknown>;
      let payload: Record<string, unknown>;
      try {
        header = JSON.parse(base64UrlDecode(parts[0]));
      } catch {
        showError('Le header (1ᵉʳ segment) n’est pas un JSON Base64URL valide.');
        return;
      }
      try {
        payload = JSON.parse(base64UrlDecode(parts[1]));
      } catch {
        showError('Le payload (2ᵉ segment) n’est pas un JSON Base64URL valide.');
        return;
      }

      renderStructure(parts);
      headerEl!.textContent = JSON.stringify(header, null, 2);
      payloadEl!.textContent = JSON.stringify(payload, null, 2);
      runSecurityChecks(header, payload);
      renderClaims(payload);
      results!.classList.remove('hidden');
    }

    function runSecurityChecks(header: Record<string, unknown>, payload: Record<string, unknown>): void {
      const alg = typeof header.alg === 'string' ? header.alg : '';

      if (alg.toLowerCase() === 'none') {
        addAlert('critical', 'alg = "none" : le token n’est pas signé. À rejeter absolument en production (contournement de signature).');
      } else if (alg.startsWith('HS')) {
        addAlert('info', `Signature symétrique (${alg}) : émetteur et vérificateur partagent le même secret. Le secret ne doit jamais fuiter côté client.`);
      } else if (alg.startsWith('RS') || alg.startsWith('ES') || alg.startsWith('PS')) {
        addAlert('info', `Signature asymétrique (${alg}) : vérifiable avec la clé publique de l’émetteur (via JWKS).`);
      } else if (alg) {
        addAlert('info', `Algorithme de signature : ${alg}.`);
      }

      const now = Math.floor(Date.now() / 1000);
      const exp = typeof payload.exp === 'number' ? payload.exp : null;
      const nbf = typeof payload.nbf === 'number' ? payload.nbf : null;
      const iat = typeof payload.iat === 'number' ? payload.iat : null;

      if (exp === null) {
        addAlert('warning', 'Aucun claim exp : ce token n’expire pas. Une durée de vie courte est recommandée (RFC 8725).');
      } else if (exp < now) {
        addAlert('warning', `Token expiré ${relative(exp - now)}.`);
      } else {
        addAlert('info', `Token valide, expire ${relative(exp - now)}.`);
      }

      if (nbf !== null && nbf > now) {
        addAlert('warning', `Token pas encore valide (nbf ${relative(nbf - now)}).`);
      }
      if (iat !== null && iat > now + 60) {
        addAlert('warning', 'Le claim iat est dans le futur : horloge désynchronisée ou token forgé ?');
      }
    }

    function renderClaims(payload: Record<string, unknown>): void {
      for (const [key, value] of Object.entries(payload)) {
        const row = el('tr', 'border-b border-white/5');
        row.appendChild(el('td', 'py-3 px-4 font-mono text-iam-cyan align-top whitespace-nowrap', key));

        const valCell = el('td', 'py-3 px-4 text-iam-text align-top break-all');
        if (TIME_CLAIMS.has(key) && typeof value === 'number') {
          valCell.appendChild(el('div', 'font-mono text-xs text-iam-muted', String(value)));
          valCell.appendChild(el('div', '', formatDate(value)));
        } else {
          valCell.textContent = stringify(value);
        }
        row.appendChild(valCell);

        row.appendChild(el('td', 'py-3 px-4 text-iam-muted align-top', CLAIM_DESCRIPTIONS[key] || '—'));
        claimsEl!.appendChild(row);
      }
    }

    function showError(message: string): void {
      results!.classList.add('hidden');
      errorBox!.textContent = message;
      errorBox!.classList.remove('hidden');
    }

    // ---- Génération d'un exemple (encodage local, signature factice) ----
    function base64UrlEncode(str: string): string {
      const bytes = new TextEncoder().encode(str);
      let binary = '';
      bytes.forEach((b) => (binary += String.fromCharCode(b)));
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function buildExample(): string {
      const header = { alg: 'RS256', typ: 'JWT', kid: 'demo-key-2026' };
      const now = Math.floor(Date.now() / 1000);
      const payload = {
        iss: 'https://sso.exemple.fr/realms/entreprise',
        sub: 'a1b2c3d4-e5f6-7890-abcd-ef1234567890',
        aud: 'app-portail-rh',
        exp: now + 3600,
        iat: now,
        nbf: now,
        auth_time: now,
        name: 'Camille Martin',
        preferred_username: 'cmartin',
        email: 'camille.martin@exemple.fr',
        email_verified: true,
        roles: ['rh-lecteur', 'collaborateur'],
        scope: 'openid profile email',
        azp: 'app-portail-rh',
        amr: ['pwd', 'mfa'],
      };
      const sig = 'SIGNATURE_FACTICE_non_verifiable_a_titre_de_demonstration';
      return `${base64UrlEncode(JSON.stringify(header))}.${base64UrlEncode(JSON.stringify(payload))}.${sig}`;
    }

    // ---- Événements ----
    input.addEventListener('input', decode);
    exampleBtn.addEventListener('click', () => {
      input.value = buildExample();
      decode();
    });
    clearBtn.addEventListener('click', () => {
      input.value = '';
      decode();
      input.focus();
    });
  }
</script>
