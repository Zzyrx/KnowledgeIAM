---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExpertiseCard from '../components/ExpertiseCard.astro';
import MissionCard from '../components/MissionCard.astro';
import CTA from '../components/CTA.astro';
import { expertises } from '../config/expertises';

const stats = [
  { value: '4 ans', label: "d'experience IAM" },
  { value: '50+', label: 'applications integrees en SSO' },
  { value: '2', label: 'grands comptes (EDF, Allianz)' },
];
---

<BaseLayout title="Jean-Baptiste Janssen — Expert IAM / SSO">
  <!-- Hero -->
  <Hero
    title='Expert <span class="text-gradient">IAM</span> / <span class="text-gradient">SSO</span>'
    subtitle="Freelance specialise en gestion des identites et des acces. ForgeRock, Microsoft Entra ID, SAML 2.0, OIDC — je securise et simplifie vos acces."
    cta={{ label: 'Discutons de votre projet', href: '/contact/' }}
    badge="Disponible pour missions"
  />

  <!-- Expertise -->
  <section class="py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 animate-on-scroll">
        <h2 class="text-2xl sm:text-3xl font-bold">Domaines d'expertise</h2>
        <p class="mt-3 text-iam-muted max-w-lg mx-auto">Solutions IAM completes, de l'annuaire aux protocoles de federation</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {expertises.slice(0, 3).map((exp, i) => (
          <div class:list={['animate-on-scroll', i === 1 && 'animate-delay-100', i === 2 && 'animate-delay-200']}>
            <ExpertiseCard {...exp} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chiffres cles -->
  <section class="py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {stats.map(({ value, label }, i) => (
          <div class:list={['animate-on-scroll glass-card p-8 text-center', i === 1 && 'animate-delay-100', i === 2 && 'animate-delay-200']}>
            <div class="text-3xl sm:text-4xl font-bold text-gradient">{value}</div>
            <div class="mt-2 text-sm text-iam-muted">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Missions -->
  <section class="py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 animate-on-scroll">
        <h2 class="text-2xl sm:text-3xl font-bold">Missions recentes</h2>
        <p class="mt-3 text-iam-muted">Interventions IAM en contexte grand compte</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="animate-on-scroll">
          <MissionCard
            company="EDF — Equipe Raccordement SSO"
            role="Integrateur SSO"
            period="2022 – 2024"
            highlights={[
              'Integration de 50+ applications en WebSSO (SAML 2.0, OIDC)',
              'Configuration connecteurs LDAP / Active Directory',
              'Automatisation du raccordement via Python & Bash',
              'Support N2/N3 sur la chaine SSO',
            ]}
          />
        </div>
        <div class="animate-on-scroll animate-delay-100">
          <MissionCard
            company="Allianz — Transformation IAM"
            role="Expert IAM"
            period="2024 – 2026"
            highlights={[
              'Infrastructure Kerberos avec automatisation des keytabs',
              'Automatisation Entra ID via Graph API & PowerShell',
              'Deploiement ForgeRock sur Kubernetes (ForgeOps)',
              'Administration OpenLDAP et support N2/N3',
            ]}
          />
        </div>
      </div>
      <div class="text-center mt-10 animate-on-scroll">
        <a href="/missions/" class="btn-secondary text-sm">
          Voir le detail des missions
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA />
</BaseLayout>
