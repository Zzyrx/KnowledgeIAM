---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpertiseCard from '../../components/ExpertiseCard.astro';
import CTA from '../../components/CTA.astro';
import { expertises } from '../../config/expertises';

// Compétences techniques détaillées (source : CV)
const skillGroups = [
  {
    label: 'Protocoles & standards',
    skills: ['SAML 2.0', 'OIDC', 'OAuth 2.0', 'LDAP', 'Kerberos', 'SCIM'],
  },
  {
    label: 'Concepts IAM',
    skills: ['Authentification', 'RBAC', 'Annuaires', 'Identités numériques', 'Fédération'],
  },
  {
    label: 'Solutions IAM',
    skills: ['ForgeRock (OpenAM)', 'Microsoft Entra ID', 'Active Directory', 'OpenLDAP', 'MS Graph', 'ForgeOps', 'Itzmi'],
  },
  {
    label: 'Environnements & développement',
    skills: ['Linux', 'Windows', 'Docker', 'Azure', 'React / SPA', 'API REST', 'TypeScript', 'Node.js'],
  },
  {
    label: 'Automatisation & méthodes',
    skills: ['Python', 'Bash', 'PowerShell', 'Git', 'Agile / Scrum'],
  },
];
---

<BaseLayout
  title="Expertise IAM — Jean-Baptiste Janssen"
  description="Compétences en gestion des identités : ForgeRock, Entra ID, OpenLDAP, Kerberos, SAML 2.0, OIDC, OAuth 2.0."
>
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-3xl sm:text-4xl font-bold">Expertise IAM</h1>
        <p class="mt-4 text-lg text-iam-muted max-w-2xl mx-auto">
          4 ans d'expérience sur les principales technologies de gestion des identités et des accès, au service de grands comptes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {expertises.map((exp) => (
          <ExpertiseCard {...exp} />
        ))}
      </div>

      <!-- Compétences techniques -->
      <div class="mt-20">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold">Compétences techniques</h2>
          <p class="mt-3 text-iam-muted max-w-2xl mx-auto">
            Une double culture infrastructure et développement, du protocole d'authentification à la sécurisation des API.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {skillGroups.map((group) => (
            <div class="glass-card p-6">
              <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{group.label}</h3>
              <ul class="flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <li class="px-3 py-1 text-xs font-medium rounded-full bg-iam-cyan/10 text-iam-cyan border border-iam-cyan/20">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
