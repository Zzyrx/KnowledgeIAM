---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpertiseCard from '../../components/ExpertiseCard.astro';
import CTA from '../../components/CTA.astro';
import { expertises } from '../../config/expertises';
---

<BaseLayout
  title="Expertise IAM — Jean-Baptiste Janssen"
  description="Compétences en gestion des identités : ForgeRock, Entra ID, OpenLDAP, Kerberos, SAML 2.0, OIDC, OAuth 2.0."
>
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-3xl sm:text-4xl font-bold">Expertise IAM</h1>
        <p class="mt-4 text-lg text-iam-muted max-w-2xl mx-auto">
          4 ans d'expérience sur les principales technologies de gestion des identités et des accès, au service de grands comptes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {expertises.map((exp) => (
          <ExpertiseCard {...exp} />
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
